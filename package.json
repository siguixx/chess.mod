{
  "name": "chess-mod",
  "version": "1.0.0",
  "description": "CHESS.MOD — Strategic Boss-Fight & Online Competitive Chess for Windows 11",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "desktop": "node desktop/launch.mjs",
    "build:win": "electron-builder --win",
    "test": "node tests/run-all.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "com.chessmod.desktop",
    "productName": "CHESS.MOD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "shared/**/*",
      "client/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
